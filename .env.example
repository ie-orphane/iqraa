# App (OAuth callbacks are derived from this URL)
APP_URL=http://localhost:3000

# Local Supabase Postgres (iqraa ports — see supabase/config.toml)
# API: http://127.0.0.1:54421  |  DB: postgresql://postgres:postgres@127.0.0.1:54422/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres

# Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Telegram OIDC (BotFather → Bot Settings → Web Login)
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
